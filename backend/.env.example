# ============================================================
#  CRM — environment o'zgaruvchilari namunasi
#  Nusxa ol:  cp .env.example .env   → keyin qiymatlarni to'ldir
#  .env HECH QACHON git'ga qo'shilmaydi!
# ============================================================

# ----------------------- Django core -------------------------
# Yangi kalit:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-generate-a-new-secret-key
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=root.settings
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_LANGUAGE_CODE=uz
DJANGO_TIME_ZONE=Asia/Tashkent

# ------------------------ Database ---------------------------
# Reja bo'yicha: PostgreSQL 16 (SQLite bilan boshlanmaydi)
POSTGRES_DB=crm_db
POSTGRES_USER=crm_user
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# settings.py aynan shu DATABASE_URL ni o'qiydi (yuqoridagi POSTGRES_* — docker-compose uchun).
# PostgreSQL uchun `psycopg[binary]` o'rnatilgan bo'lishi shart.
DATABASE_URL=postgres://crm_user:change-me-strong-password@localhost:5432/crm_db
# Postgres hali tayyor bo'lmasa, bu qatorni butunlay izohga ol —
# settings.py BASE_DIR/db.sqlite3 ga tushib qoladi.

# -------------------------- Redis ----------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0
CACHE_URL=redis://localhost:6379/1
CACHE_TTL=300
# False bo'lsa — LocMemCache ishlatiladi (Redis kerak emas)
USE_REDIS_CACHE=True

# ------------------------- Celery ----------------------------
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/3
CELERY_TASK_ALWAYS_EAGER=False

# --------------------------- JWT -----------------------------
# Reja: access 30 daqiqa, refresh 7 kun
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True

# --------------------- Telegram bot (aiogram) ----------------
# Token @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
TELEGRAM_BOT_USERNAME=my_crm_bot
TELEGRAM_ADMIN_CHAT_ID=
# Tasdiqlash kodi sozlamalari
VERIFICATION_CODE_TTL_SECONDS=120
VERIFICATION_CODE_MAX_ATTEMPTS=3

# --------------------------- CORS ----------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_ALL_ORIGINS=False

# ------------------------ Media / S3 -------------------------
# dev: local, prod: s3 (yoki minio)
MEDIA_STORAGE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=

# --------------------------- Email ---------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@crm.local

# ---------------------- Superuser (seed) ---------------------
DJANGO_SUPERUSER_PHONE_NUMBER=+998901234567
DJANGO_SUPERUSER_EMAIL=admin@crm.local
DJANGO_SUPERUSER_PASSWORD=change-me-admin-password

# ------------------- Monitoring (ixtiyoriy) ------------------
SENTRY_DSN=
LOG_LEVEL=INFO
